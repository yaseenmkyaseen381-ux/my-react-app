PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mobix
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Gmail SMTP settings for OTP delivery. Use a Gmail App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="MOBIX <your-email@gmail.com>"

# Use the same Web OAuth client ID configured in frontend/.env.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional Razorpay test/live API credentials. Keep these only in the backend.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
